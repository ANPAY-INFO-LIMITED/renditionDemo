# RenditionDemo 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== AI API 配置 ==========
# 火山引擎 ARK API 密钥
AI_API_KEY=your_volcengine_ark_api_key_here
AI_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/

# ========== 应用配置 ==========
# Streamlit 服务器配置
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# 任务数据存储路径
TASKS_DIR=/var/www/renditiondemo/tasks

# 最大上传文件大小（字节）
MAX_VIDEO_SIZE=524288000

# ========== 可选配置 ==========
# 日志级别
LOG_LEVEL=INFO

# CORS 设置
CORS_ALLOWED_ORIGINS=https://your-domain.com
